# ── Database (existing Supabase Postgres, session pooler) ──────────────────
POSTGRES_URL=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
POSTGRES_USER=postgres.bmbbifxkjqmdqriootdw
POSTGRES_PASSWORD=your-db-password

# ── JWT (reuse the SAME secret as the original app so existing tokens/users work) ──
JWT_SECRET=your-32+char-hex-secret

# ── Auth / cookies ─────────────────────────────────────────────────────────
# In production both apps share the parent domain, so cookies are scoped to it:
#   COOKIE_DOMAIN=.pritamrao.tech   COOKIE_SECURE=true   COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
DEFAULT_PASSWORD=Welcome@123

# ── CORS / frontend ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173

# ── Cloudflare R2 (S3-compatible) ──────────────────────────────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET_NAME=kkr-hms

# ── Brevo email (password-reset) ───────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@kkrhospital.com
BREVO_SENDER_NAME=KKR Hospital

# ── Server ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080
